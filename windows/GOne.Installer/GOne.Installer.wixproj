<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>GOne.Client-x64</OutputName>
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\dist\publish</PublishDir>
    <WireGuardRuntimeDir Condition="'$(WireGuardRuntimeDir)' == ''">$(MSBuildThisFileDirectory)..\dist\wireguard</WireGuardRuntimeDir>
    <!-- WiX preprocessor variables are not created automatically from MSBuild
         properties. Explicitly export the paths consumed by Package.wxs. -->
    <DefineConstants>$(DefineConstants);PublishDir=$(PublishDir);WireGuardRuntimeDir=$(WireGuardRuntimeDir)</DefineConstants>
  </PropertyGroup>
</Project>
