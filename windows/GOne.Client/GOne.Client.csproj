<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GOne.Client</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <None Update="clientsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="$(IntermediateOutputPath)wireguard-installer.exe"
                      LogicalName="GOne.Client.Resources.wireguard-installer.exe" />
  </ItemGroup>
  <Target Name="AcquireWireGuardRuntime" BeforeTargets="PrepareForBuild"
          Condition="!Exists('$(IntermediateOutputPath)wireguard-installer.exe')">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <DownloadFile SourceUrl="https://download.wireguard.com/windows-client/wireguard-installer.exe"
                  DestinationFolder="$(IntermediateOutputPath)" />
  </Target>
</Project>
